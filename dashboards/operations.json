                        "rawSql": "SELECT\n    start_time AS \"Started\",\n    coalesce(task_id, '(manual run)') AS \"Task\",\n    steps AS \"Steps\",\n    stop_reason AS \"Stop reason\",\n    duration_ms / 1000 AS \"Seconds\",\n    CASE\n        WHEN passed IS NULL THEN '-'\n        WHEN passed THEN 'pass'\n        ELSE 'fail'\n    END AS \"Passed\",\n    trace_id AS \"Trace ID\"\nFROM telemetry.agent_runs\nWHERE $__timeFilter(start_time)\nORDER BY duration_ms DESC\nLIMIT 15",
